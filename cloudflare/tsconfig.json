{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Runtime types come from the generated worker-configuration.d.ts (see the
    // include list). Only the vitest pool's "cloudflare:test" module needs to be
    // pulled in via the types array.
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "vitest.config.ts"]
}
